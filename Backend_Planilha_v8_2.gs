function ativarBackup_(){ScriptApp.getProjectTriggers().forEach(function(t){if(t.getHandlerFunction()==='executarBackupDiario')ScriptApp.deleteTrigger(t)});ScriptApp.newTrigger('executarBackupDiario').timeBased().everyDays(1).atHour(2).create();return{ok:true,mensagem:'Backup diário ativado para aproximadamente 02:00.'}}
function anexarComprovante_(p){let ss=SpreadsheetApp.openById(ID),h=ss.getSheetByName(ABA_HISTORICO),cod=String(p.codigo||''),nome=String(p.morador||''),arquivo=String(p.arquivo||'').trim(),obs=String(p.observacao||'').trim();if(!h)throw Error('Aba Histórico Cobranças não encontrada.');if(!cod||!arquivo)throw Error('Morador ou arquivo inválido.');let comp=new Date();try{let x=contextoAtual_(),i=x.dados.find(function(a){return String(a.row[2])===cod});if(i){comp=i.row[1];let atual=String(i.row[19]||'').trim(),texto='Comprovante anexado: '+arquivo+(obs?' — '+obs:'');x.sheet.getRange(i.linha,20).setValue(atual?atual+'\n'+texto:texto)}}catch(e){}h.appendRow([new Date(),cod,nome,comp,'COMPROVANTE','Arquivo local','ANEXADO','Comprovante: '+arquivo+(obs?' — '+obs:'')]);SpreadsheetApp.flush();return{ok:true}}
